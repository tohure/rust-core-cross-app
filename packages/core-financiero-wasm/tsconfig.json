{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    // Sin `"types": ["node"]`, a propósito: a diferencia de `packages/contract` (cuyo
    // `testing.ts` sí queda dentro de `include` y usa `node:fs`), nada de lo que `tsc` ve acá
    // toca APIs de Node — `initCore` recibe `ArrayBuffer | Uint8Array`, tipos de `lib.esnext`. El
    // único archivo que usa `node:fs`/`node:path` es `src/__tests__/facade.test.ts`, y ese queda
    // fuera vía `exclude`. Agregar `@types/node` sin necesidad sería una dependency de más.
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "noEmit": true
  },
  "include": ["src"],
  // Igual que en `packages/contract`: los tests importan `@jest/globals` sin declararlo como
  // dependency instalada de este paquete (declararlo desvía la resolución de peers de pnpm en
  // todo el workspace). Sin esa dependency, `tsc` no resuelve sus tipos de forma aislada acá.
  // Los tests SÍ tipan y corren dentro del Jest de `apps/react-native`, que sí la tiene
  // instalada — por eso quedan fuera del `typecheck` de este paquete, no del proyecto.
  "exclude": ["src/__tests__"]
}
